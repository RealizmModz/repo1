<Window x:Class="ATS.Dispatcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATS Dispatcher | Prototype" Width="1080" Height="770"
        MinWidth="820" MinHeight="620"
        Background="#101827" Foreground="#F3F4F6">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="CUSTOM FREIGHT DISPATCHER" Foreground="#38BDF8"
                       FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Plan your next haul" FontSize="30" FontWeight="Bold" Margin="0,4"/>
            <TextBlock Text="Drafts only in this version. No ATS save files are modified."
                       Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,5"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#172336" CornerRadius="12" Padding="20" Grid.Column="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="JOB DETAILS" FontWeight="Bold" Foreground="#93C5FD"/>
                        <TextBlock Text="Job name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameInput" Text="My custom haul"/>
                        <TextBlock Text="Pickup city" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OriginInput" Text="Rapid City"/>
                        <TextBlock Text="Destination city" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DestinationInput" Text="Los Angeles"/>
                        <TextBlock Text="Cargo" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CargoInput" Text="Heavy machinery"/>
                        <TextBlock Text="Trailer type" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TrailerInput" Text="Lowboy"/>
                        <TextBlock Text="Requested payout in USD (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PaymentInput" Text=""/>
                        <TextBlock Text="Route waypoints — one city per line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WaypointsInput" Height="100" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,20,0,0">
                            <Button Content="Export job draft" Click="ExportClick" Background="#0284C7"/>
                            <Button Content="Import draft" Click="ImportClick"/>
                            <Button Content="Clear" Click="ClearClick"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="#172336" CornerRadius="12" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ATS PROFILE DISCOVERY" FontWeight="Bold" Foreground="#93C5FD"/>
                        <TextBlock Text="Local saves found in Documents (read-only)" TextWrapping="Wrap"
                                   Foreground="#CBD5E1" Margin="0,8,0,12"/>
                        <Button Content="Scan for saves" Click="RefreshSavesClick" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap"
                               Foreground="#94A3B8" FontSize="12" Margin="0,12,0,0"
                               Text="ScsC and BSII signatures are detected, not decrypted. Steam Cloud-only saves may not appear."/>
                    <ListBox x:Name="SavesList" Margin="0,16,0,0"
                             Foreground="White" Background="#1E293B"
                             BorderBrush="#334155" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusMessage" Text="Ready to create a draft."
                   Margin="0,14,0,0" Foreground="#94A3B8" TextWrapping="Wrap"/>
    </Grid>
</Window>
