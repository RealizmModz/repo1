<Window x:Class="ATS.Dispatcher.App.FreightMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATS Custom Dispatcher — Freight Market Preview"
        Width="1400" Height="920" MinWidth="1010" MinHeight="710"
        WindowStartupLocation="CenterScreen"
        Background="#13191F" Foreground="#F1F3F4"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#B2BCC5"/>
        <SolidColorBrush x:Key="Amber" Color="#E8A23A"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#B2BCC5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDF3F7"/>
            <Setter Property="Background" Value="#18252E"/>
            <Setter Property="BorderBrush" Value="#52626E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="31"/>
            <Setter Property="CaretBrush" Value="#E8A23A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#33414A"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Setter Property="BorderBrush" Value="#64717A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,7"/>
        </Style>
        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C88B2F"/>
            <Setter Property="Foreground" Value="#14191F"/>
            <Setter Property="BorderBrush" Value="#E7A74B"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="MapPin" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E8A23A"/>
            <Setter Property="Foreground" Value="#11171B"/>
            <Setter Property="BorderBrush" Value="#FFF0C2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#202B33"/>
            <Setter Property="Foreground" Value="#F1F3F4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#71572D"/>
                    <Setter Property="BorderBrush" Value="#E8A23A"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="19,12,19,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AMERICAN TRUCK SIMULATOR • INSPIRED FREIGHT PLANNER"
                           Foreground="#E8A23A" FontWeight="Bold" FontSize="11"/>
                <TextBlock Text="CUSTOM DISPATCHER" FontSize="29" FontWeight="Bold"
                           CharacterSpacing="1"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PLANNER MODE" Foreground="#E8A23A"
                           FontSize="15" FontWeight="Bold" TextAlignment="Right"/>
                <TextBlock Text="NO GAME SAVES MODIFIED" Foreground="#B2BCC5"
                           FontSize="11" TextAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#C68C32" Padding="19,8">
                <TextBlock Text="FREIGHT MARKET" Foreground="#181C21" FontWeight="Bold"/>
            </Border>
            <Border Grid.Column="1" Background="#27343D" Padding="19,8" Margin="3,0,0,0">
                <TextBlock Text="CUSTOM JOB EDITOR" Foreground="#F1F3F4" FontWeight="SemiBold"/>
            </Border>
            <Border Grid.Column="2" Background="#202B33" Margin="3,0,0,0"
                    HorizontalAlignment="Stretch" Padding="14,8">
                <TextBlock Text="OFFLINE UI PREVIEW • ROUTE IS SCHEMATIC, NOT ATS GPS"
                           Foreground="#B2BCC5" HorizontalAlignment="Right"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#3C4851" BorderThickness="1"
                    Background="#202B33">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="4,2,4,10">
                        <TextBlock Text="ROUTE OVERVIEW" FontWeight="Bold" FontSize="16"
                                   Foreground="#E8A23A" DockPanel.Dock="Left"/>
                        <TextBlock Text="SCHEMATIC PREVIEW • NOT TO SCALE"
                                   Foreground="#A9BAC3" FontSize="11"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#17232B" BorderBrush="#354752"
                            BorderThickness="1" MinHeight="260">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch">
                            <Canvas Width="690" Height="440">
                                <Canvas.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1B2C35" Offset="0"/>
                                        <GradientStop Color="#112029" Offset="1"/>
                                    </LinearGradientBrush>
                                </Canvas.Background>
                                <!-- Original schematic detail, NOT copied SCS map data -->
                                <Polyline Points="5,102 138,151 265,108 397,152 540,93 675,134"
                                          Stroke="#314550" StrokeThickness="14" StrokeLineJoin="Round"/>
                                <Polyline Points="60,25 145,130 205,236 376,296 542,381 678,414"
                                          Stroke="#263F4C" StrokeThickness="8" StrokeLineJoin="Round"/>
                                <Polyline Points="8,320 130,278 277,325 452,262 639,300"
                                          Stroke="#29424C" StrokeThickness="9" StrokeLineJoin="Round"/>
                                <Polyline Points="325,10 339,91 260,190 339,289 315,420"
                                          Stroke="#2A444D" StrokeThickness="7" StrokeLineJoin="Round"/>
                                <Polyline Points="66,186 194,192 307,143 430,179 595,168"
                                          Stroke="#36515C" StrokeThickness="3" StrokeDashArray="4,6"/>
                                <Polyline Points="137,304 327,182 536,110"
                                          Stroke="#162329" StrokeThickness="15" StrokeLineJoin="Round"/>
                                <Polyline Points="137,304 327,182 536,110"
                                          Stroke="#E8A23A" StrokeThickness="6" StrokeLineJoin="Round"/>
                                <Polyline Points="137,304 327,182 536,110"
                                          Stroke="#F7CB6A" StrokeThickness="2"
                                          StrokeDashArray="7,7"/>
                                <Button Canvas.Left="115" Canvas.Top="282" Content="A"
                                        Style="{StaticResource MapPin}" Click="FocusPickup_Click"
                                        ToolTip="Click to edit pickup"/>
                                <Button Canvas.Left="306" Canvas.Top="159" Content="V"
                                        Style="{StaticResource MapPin}" Click="FocusWaypoint_Click"
                                        ToolTip="Click to edit waypoints"/>
                                <Button Canvas.Left="516" Canvas.Top="88" Content="B"
                                        Style="{StaticResource MapPin}" Click="FocusDestination_Click"
                                        ToolTip="Click to edit destination"/>
                                <TextBlock Canvas.Left="41" Canvas.Top="346"
                                           Text="PICKUP" Foreground="#E8A23A"
                                           FontWeight="Bold" FontSize="12"/>
                                <TextBlock Canvas.Left="41" Canvas.Top="365"
                                           x:Name="MapOriginLabel" Text="Rapid City"
                                           FontSize="18" Foreground="White" MaxWidth="235"/>
                                <TextBlock Canvas.Left="252" Canvas.Top="222"
                                           Text="WAYPOINTS" Foreground="#E8A23A"
                                           FontWeight="Bold" FontSize="12"/>
                                <TextBlock Canvas.Left="252" Canvas.Top="241"
                                           x:Name="MapViaLabel" Text="DIRECT (schematic)"
                                           FontSize="14" Foreground="White" MaxWidth="245"/>
                                <TextBlock Canvas.Left="510" Canvas.Top="45"
                                           Text="DELIVERY" Foreground="#E8A23A"
                                           FontWeight="Bold" FontSize="12"/>
                                <TextBlock Canvas.Left="510" Canvas.Top="63"
                                           x:Name="MapDestinationLabel" Text="Denver"
                                           FontSize="17" Foreground="White" MaxWidth="180"/>
                                <TextBlock Canvas.Left="28" Canvas.Top="18"
                                           Text="ROUTE VISUALIZATION ONLY" Foreground="#A7BBC5"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Border Grid.Row="2" Background="#29343C" Padding="14,12"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="SELECTED CUSTOM ROUTE" FontWeight="Bold"
                                       Foreground="#E8A23A" FontSize="11"/>
                            <TextBlock x:Name="RouteSummary" Text="Rapid City → Denver"
                                       Foreground="#FFFFFF" FontSize="17"
                                       FontWeight="SemiBold" Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="Distance and ETA unavailable until a verified ATS road graph is integrated."
                                       TextWrapping="Wrap" Foreground="#C3D1D9"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="↔ Reverse route" Click="ReverseRoute_Click"/>
                        <Button Content="Edit pickup" Click="FocusPickup_Click"/>
                        <Button Content="Edit destination" Click="FocusDestination_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#3C4851" BorderThickness="1"
                    Background="#202B33">
                <Grid Margin="13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.55*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="3,0,3,8">
                        <TextBlock Text="AVAILABLE FREIGHT" FontWeight="Bold" FontSize="16"
                                   Foreground="#E8A23A" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="OfferCountLabel" Text="DEMONSTRATION DATA"
                                   Foreground="#A9BAC3" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" x:Name="SearchBox" Margin="0,0,0,9"
                             TextChanged="SearchChanged"
                             ToolTip="Filter cargo, company, destination, trailer or offer ID"/>
                    <ListBox Grid.Row="2" x:Name="FreightList"
                             Background="#17232B" BorderBrush="#3C4851"
                             BorderThickness="1" Padding="5" MinHeight="150"
                             Foreground="#F1F3F4"
                             SelectionChanged="FreightSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SourceLabel}"
                                                   Foreground="#E8A23A" FontSize="10"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White" FontWeight="Bold"
                                                   FontSize="16" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding DisplayDestination}"
                                                   Foreground="#DBE5EA" FontSize="13"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DisplayTrailer}"
                                                   Foreground="#BFCED6" FontSize="12"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="#95ADB9" FontSize="11"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" Background="#29343C" Padding="8,6" Margin="0,10,0,6">
                        <TextBlock x:Name="CurrentCardStatus"
                                   Text="Select a card to copy its cargo into your draft."
                                   Foreground="#CEDBE1" TextWrapping="Wrap"/>
                    </Border>
                    <Border Grid.Row="4" Background="#17232B" BorderBrush="#354752"
                            BorderThickness="1" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="EDIT YOUR DISPATCH" FontWeight="Bold"
                                           Foreground="#E8A23A" FontSize="15"/>
                                <TextBlock Text="Pickup city" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="OriginBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Pickup company (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="OriginCompanyBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Destination city" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DestinationBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Destination company (optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DestinationCompanyBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Cargo" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CargoBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Trailer / body type" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TrailerBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Optional requested payout (USD, draft only)"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PayoutBox" TextChanged="DraftChanged"/>
                                <TextBlock Text="Waypoints (one city per line)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WaypointsBox" Height="65"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         TextChanged="DraftChanged"/>
                                <TextBlock x:Name="EditorValidation" Foreground="#EAC27A"
                                           Text="No job has been sent to ATS."
                                           TextWrapping="Wrap" Margin="0,10,0,3"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0">
                <Button Content="Import decoded offers" Click="InspectDecoded_Click"/>
                <Button Content="Import game definitions" Click="ImportCatalog_Click"/>
                <Button Content="Import draft" Click="ImportDraft_Click"/>
                <Button Content="Save draft JSON" Style="{StaticResource AccentButton}"
                        Click="SaveDraft_Click"/>
                <Button Content="Preview / validate" Click="Preview_Click"/>
                <Button Content="Advanced tools" Click="Advanced_Click"/>
                <Button Content="Create ATS Job (not available)"
                        IsEnabled="False"
                        ToolTip="Disabled until verified in-game job injection is implemented"/>
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="MarketStatus" Text="Planner ready — demonstration entries only."
                       Foreground="#B2BCC5" TextWrapping="Wrap" Margin="3,0,0,0"/>
        </Grid>
    </Grid>
</Window>
